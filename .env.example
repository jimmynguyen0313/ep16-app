# Copy to .env.local (git-ignored) and paste your TMDB "API Read Access Token" (v4).
# Get one free at https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_READ_TOKEN=

# Supabase project (Project Settings -> API keys). Both are public by design: they ship in the app,
# and the database's row-level security rules keep each person's diary private.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
